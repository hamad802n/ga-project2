<nav>

    <div class="nav-left">
        <% if (typeof countries === 'undefined'){ %>
        <a class="nav-home" href="/">Homepage</a>
        <% } %>

        <% if (typeof countries !== 'undefined'){ %>
        <form class="filter" action="/" method="get">
            <label for="country">Location:</label>
            <select name="country" id="country">
                <option value="">All locations</option>
                <% for(let oneCountry of countries){ %>
                <option value="<%= oneCountry %>" <%= oneCountry === selectedCountry ? 'selected' : '' %>><%= oneCountry %></option>
                <% } %>
            </select>
            <button class="btn">Filter</button>
        </form>
        <% } %>
    </div>

    <div class="nav-bubble">
    <% if (user){ %>
    <% if (user.role === "admin"){ %>
    <a href="/hotels/new">Add Hotel</a>
    <% } %>
    <a href="/bookings/new">Book a Hotel</a>
    <a href="/bookings">My Bookings</a>
    <a href="/auth/sign-out">Logout</a>

    <% } else{ %>
    <a href="/auth/sign-up">Sign up</a>
    <a href="/auth/sign-in">Sign in</a>

    <% } %>
    </div>

</nav>
