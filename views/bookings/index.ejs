<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Bookings</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <h1>My Bookings</h1>

    <% for(let oneBooking of bookings){ %>
        <h2><%= oneBooking.hotel.name %></h2>
        <p>Check In: <%= oneBooking.checkIn.toDateString() %></p>
        <p>Check Out: <%= oneBooking.checkOut.toDateString() %></p>
        <p>Guests: <%= oneBooking.guests %> | Rooms: <%= oneBooking.rooms %></p>
        <p>Total Price: $<%= oneBooking.totalPrice %></p>
        <p>Status: <%= oneBooking.status %></p>
    <% } %>
</body>
</html>
