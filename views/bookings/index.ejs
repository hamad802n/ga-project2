<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Bookings</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="page">
    <%- include('../partials/navbar') %>

    <h1 class="page-title">My Bookings</h1>
    <p class="page-subtitle">All your stays in one place</p>

    <% if(bookings.length === 0){ %>
        <div class="form-card empty">
            <h2>No bookings yet</h2>
            <p class="location">Find a hotel and book your first stay.</p>
            <a class="btn" href="/bookings/new">Book a Hotel</a>
        </div>
    <% } %>

    <div class="booking-list">
    <% for(let oneBooking of bookings){ %>
        <div class="booking-card">
            <span class="status status-<%= oneBooking.status %>"><%= oneBooking.status %></span>
            <h2><%= oneBooking.hotel.name %></h2>
            <p class="location"><%= oneBooking.hotel.city %>, <%= oneBooking.hotel.country %></p>

            <p class="booking-info"><span>Check In</span><span><%= oneBooking.checkIn.toDateString() %></span></p>
            <p class="booking-info"><span>Check Out</span><span><%= oneBooking.checkOut.toDateString() %></span></p>
            <p class="booking-info"><span>Guests / Rooms</span><span><%= oneBooking.guests %> / <%= oneBooking.rooms %></span></p>
            <p class="booking-info"><span>Total</span><span class="total">$<%= oneBooking.totalPrice %></span></p>

            <a class="btn" href="/bookings/<%= oneBooking._id %>">See Details</a>

            <div class="actions">
                <a class="btn btn-outline" href="/bookings/<%= oneBooking._id %>/edit">Edit</a>
                <form action="/bookings/<%= oneBooking._id %>?_method=DELETE" method="post">
                    <button class="btn btn-danger">Cancel</button>
                </form>
            </div>
        </div>
    <% } %>
    </div>
</body>
</html>
