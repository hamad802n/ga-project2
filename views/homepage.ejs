<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
</head>
<body>
    <%- include('./partials/navbar') %>

    <h1>Welcome to my Website</h1>

    <% for(let oneHotel of hotels){ %>
        <h2><%= oneHotel.name %></h2>
        <% if (oneHotel.image){ %>
        <img src="<%= oneHotel.image %>" alt="<%= oneHotel.name %>" width="300">
        <% } %>
        <p><%= oneHotel.city %>, <%= oneHotel.country %></p>
        <p>$<%= oneHotel.pricePerNight %> per night</p>
    <% } %>

</body>
</html>