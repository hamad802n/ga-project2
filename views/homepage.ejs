<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HS Hotels</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <video class="bg-video" autoplay muted loop playsinline>
        <source src="/videos/background.mp4" type="video/mp4">
    </video>
    <div class="bg-overlay"></div>

    <%- include('./partials/navbar') %>

    <h1 class="welcome">HS Hotels</h1>

    <div class="hotels">
    <% for(let oneHotel of hotels){ %>
        <div class="hotel-card">
            <% if (oneHotel.image){ %>
            <img src="<%= oneHotel.image %>" alt="<%= oneHotel.name %>">
            <% } %>
            <h2><%= oneHotel.name %></h2>
            <p><%= oneHotel.city %>, <%= oneHotel.country %></p>
            <p class="price">$<%= oneHotel.pricePerNight %> per night</p>
            <% if (user && user.role === "admin"){ %>
            <a class="btn btn-outline edit-hotel" href="/hotels/<%= oneHotel._id %>/edit">Edit Hotel</a>
            <form action="/hotels/<%= oneHotel._id %>?_method=DELETE" method="post">
                <button class="btn btn-danger edit-hotel">Delete</button>
            </form>
            <% } %>
        </div>
    <% } %>
    </div>

</body>
</html>