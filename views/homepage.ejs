<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('./partials/navbar') %>

    <h1 class="welcome">Welcome to my Website</h1>

    <div class="hotels">
    <% for(let oneHotel of hotels){ %>
        <div class="hotel-card">
            <% if (oneHotel.image){ %>
            <img src="<%= oneHotel.image %>" alt="<%= oneHotel.name %>">
            <% } %>
            <h2><%= oneHotel.name %></h2>
            <p><%= oneHotel.city %>, <%= oneHotel.country %></p>
            <p class="price">$<%= oneHotel.pricePerNight %> per night</p>
        </div>
    <% } %>
    </div>

</body>
</html>